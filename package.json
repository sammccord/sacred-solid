{
  "name": "sacred-solid",
  "version": "0.1.0",
  "description": "SolidJS port of SRCL, the Sacred Computer component library with terminal aesthetics.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sammccord/sacred-solid.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css",
    "./global.css": "./dist/styles/global.css",
    "./global-fonts.css": "./dist/styles/global-fonts.css",
    "./themes/holo.css": "./dist/themes/holo.css",
    "./themes/acid.css": "./dist/themes/acid.css",
    "./themes/redline.css": "./dist/themes/redline.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config",
    "playground": "vp dev",
    "build:playground": "vp build",
    "parity": "vpx scripts/parity.ts",
    "chrome-strip": "vpx scripts/chrome-strip.ts",
    "check-layers": "vpx scripts/check-layers.ts",
    "changeset": "changeset"
  },
  "dependencies": {
    "augmented-ui": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@changesets/cli": "^3.0.3",
    "@solidjs/babel-plugin": "^2.0.0-rc.21",
    "@solidjs/testing-library": "^1.0.0-rc.2",
    "@solidjs/vite-plugin": "^3.0.0-next.57",
    "@solidjs/web": "^2.0.0-rc.21",
    "@types/node": "^26.6.5",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@ui-sdk/core": "^0.1.0-beta.1",
    "@ui-sdk/solid": "^0.1.0-beta.1",
    "jsdom": "^31.0.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "solid-js": "^2.0.0-rc.21",
    "typescript": "^7.0.2",
    "vite-plus": "^1.2.0"
  },
  "peerDependencies": {
    "@solidjs/web": ">=2.0.0-rc.21 <3",
    "solid-js": ">=2.0.0-rc.21 <3"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "inlinedDependencies": {
    "augmented-ui": "2.0.0"
  }
}
